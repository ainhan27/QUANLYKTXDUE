    <bpmn:subProcess id="SP6" name="6. Bàn giao phòng">
      <bpmn:documentation>Giai đoạn 6 - Bàn giao phòng. Gửi email hẹn nhận phòng kèm số phòng, bàn giao chìa khóa và kiểm kê cơ sở vật chất, ghi nhận số phòng vào portal nội trú.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:dataInputAssociation id="MA13">
        <bpmn:sourceRef>MD_HD</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
