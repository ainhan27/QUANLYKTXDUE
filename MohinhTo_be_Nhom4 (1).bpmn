        <bpmn:targetRef>MD_BB</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="MA17">
        <bpmn:targetRef>MDS_PT</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="S6" name="Sinh viên đã ký hợp đồng">
        <bpmn:outgoing>F601</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="GM" name="Gửi email hẹn nhận phòng kèm số phòng">
        <bpmn:documentation>Gửi email hẹn ngày nhận phòng kèm số phòng và mã QR check-in.</bpmn:documentation>
        <bpmn:incoming>F601</bpmn:incoming>
        <bpmn:outgoing>F602</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A601">
          <bpmn:sourceRef>D6_hd</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="A602">
          <bpmn:sourceRef>D6_ph</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:messageEventDefinition id="GM_def" messageRef="Msg_NhanPhong" />
      </bpmn:intermediateThrowEvent>
      <bpmn:manualTask id="E2" name="Bàn giao chìa khóa, kiểm kê cơ sở vật chất phòng">
        <bpmn:documentation>Cán bộ QLSV gặp sinh viên, bàn giao chìa khóa, kiểm kê cơ sở vật chất và lập biên bản.</bpmn:documentation>
