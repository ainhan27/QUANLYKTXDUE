<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ToBe_v13" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:resource id="Res_TB" name="Trưởng ban quản lý KTX" />
  <bpmn:resource id="Res_HC" name="Bộ phận hành chính" />
  <bpmn:resource id="Res_QLSV" name="Bộ phận quản lý sinh viên" />
  <bpmn:dataStore id="DataStore_HS" name="CSDL hồ sơ đăng ký" />
  <bpmn:dataStore id="DataStore_PT" name="Portal quản lý nội trú" />
  <bpmn:message id="Msg_DK" name="Hồ sơ đăng ký online" />
  <bpmn:message id="Msg_TuChoi" name="Thông báo từ chối bố trí ở KTX" />
  <bpmn:message id="Msg_YCBS" name="Email yêu cầu bổ sung minh chứng" />
  <bpmn:message id="Msg_BS" name="Minh chứng bổ sung" />
  <bpmn:message id="Msg_KhongXet" name="Thông báo hồ sơ không được xét" />
  <bpmn:message id="Msg_CongBo" name="Kết quả xét kèm hợp đồng điện tử" />
  <bpmn:message id="Msg_PhanHoi" name="Phản hồi hợp đồng (ký / từ chối)" />
  <bpmn:message id="Msg_Huy" name="Thông báo hủy suất" />
  <bpmn:message id="Msg_NhanPhong" name="Email hẹn nhận phòng, bàn giao phòng" />
  <bpmn:error id="Err_HoKhau" name="Hồ sơ bị từ chối bố trí (hộ khẩu Đà Nẵng)" errorCode="ERR_HO_KHAU_DA_NANG" />
  <bpmn:error id="Err_KhongXet" name="Hồ sơ không được xét (không bổ sung kịp)" errorCode="ERR_KHONG_BO_SUNG_KIP" />
  <bpmn:error id="Err_AI" name="Lỗi kết nối / quá tải API AI" errorCode="ERR_AI_API" />
  <bpmn:error id="Err_Huy" name="Suất bị hủy (từ chối ký / quá hạn ký)" errorCode="ERR_HUY_SUAT" />
  <bpmn:collaboration id="Collab_ToBe">
    <bpmn:participant id="Pool_KTX" name="Ban quản lý KTX (Nhà trường) - To Be" processRef="Process_KTX_ToBe" />
    <bpmn:participant id="Pool_SV" name="Tân sinh viên" processRef="Process_SV_ToBe" />
    <bpmn:messageFlow id="MF1" sourceRef="SV_T" targetRef="A1" messageRef="Msg_DK" />
    <bpmn:messageFlow id="MF2" sourceRef="ETC" targetRef="Pool_SV" messageRef="Msg_TuChoi" />
    <bpmn:messageFlow id="MF3" sourceRef="SP2" targetRef="Pool_SV" messageRef="Msg_YCBS" />
    <bpmn:messageFlow id="MF4" sourceRef="Pool_SV" targetRef="SP2" messageRef="Msg_BS" />
    <bpmn:messageFlow id="MF5" sourceRef="EO" targetRef="Pool_SV" messageRef="Msg_KhongXet" />
    <bpmn:messageFlow id="MF6" sourceRef="SP5" targetRef="Pool_SV" messageRef="Msg_CongBo" />
    <bpmn:messageFlow id="MF11" sourceRef="Pool_SV" targetRef="SP5" messageRef="Msg_PhanHoi" />
    <bpmn:messageFlow id="MF13" sourceRef="EA" targetRef="Pool_SV" messageRef="Msg_Huy" />
    <bpmn:messageFlow id="MF15" sourceRef="SP6" targetRef="Pool_SV" messageRef="Msg_NhanPhong" />
  </bpmn:collaboration>
  <bpmn:process id="Process_KTX_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_TB" name="Trưởng ban quản lý KTX">
        <bpmn:flowNodeRef>SP4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HC" name="Bộ phận hành chính">
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ETC</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QLSV" name="Bộ phận quản lý sinh viên">
        <bpmn:flowNodeRef>SP2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EA</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="DOB_HS" name="Hồ sơ đăng ký" />
    <bpmn:dataObject id="DOB_MC" name="Minh chứng ưu tiên" />
    <bpmn:dataObject id="DOB_KQ" name="Kết quả thẩm định AI" />
    <bpmn:dataObject id="DOB_XH" name="Bảng xếp hạng dự kiến" />
    <bpmn:dataObject id="DOB_DS" name="Danh sách xét duyệt" />
    <bpmn:dataObject id="DOB_HD" name="Hợp đồng điện tử" />
    <bpmn:dataObject id="DOB_BB" name="Biên bản bàn giao phòng" />
    <bpmn:startEvent id="A1" name="Nhận hồ sơ đăng ký online của sinh viên">
      <bpmn:documentation>Message Start Event: sinh viên nộp hồ sơ và minh chứng ưu tiên trên Web/App.</bpmn:documentation>
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="A1_def" messageRef="Msg_DK" />
    </bpmn:startEvent>
    <bpmn:subProcess id="SP1" name="1. Tiếp nhận &#38; sàng lọc hồ sơ">
      <bpmn:documentation>Giai đoạn 1 - Tiếp nhận &amp; sàng lọc. Kích hoạt khi sinh viên nộp hồ sơ online. Hệ thống tự động ghi nhận hồ sơ vào CSDL và loại hồ sơ có hộ khẩu Đà Nẵng (15%). Kết thúc bình thường: hồ sơ hợp lệ chuyển sang thẩm định (85%). Kết thúc lỗi ERR_HO_KHAU_DA_NANG: từ chối bố trí ở KTX.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
      <bpmn:dataInputAssociation id="MA01">
        <bpmn:sourceRef>MD_HS0</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="MA02">
        <bpmn:targetRef>MD_HS1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="MA03">
        <bpmn:targetRef>MDS_HS</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="S1" name="Hồ sơ đã nộp online">
        <bpmn:outgoing>F101</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="A2" name="Tự động tiếp nhận, ghi nhận hồ sơ và cập nhật danh sách đăng ký">
        <bpmn:documentation>Hệ thống tự động (luật/RPA). Ghi nhận hồ sơ (mã sinh viên, đường dẫn ảnh minh chứng trên Cloud Storage) vào CSDL hồ sơ đăng ký; trạng thái hồ sơ: PENDING.</bpmn:documentation>
        <bpmn:incoming>F101</bpmn:incoming>
        <bpmn:outgoing>F102</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A101">
          <bpmn:sourceRef>D1_in</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A102">
          <bpmn:targetRef>D1_ok</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:dataOutputAssociation id="A103">
          <bpmn:targetRef>D1_db</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:performer id="pf_A2" name="Chịu trách nhiệm: Bộ phận hành chính">
          <bpmn:resourceRef>Res_HC</bpmn:resourceRef>
        </bpmn:performer>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A4" name="SV có hộ khẩu Đà Nẵng?">
        <bpmn:documentation>Có (15%): từ chối bố trí. Không (85%): chuyển thẩm định minh chứng.</bpmn:documentation>
        <bpmn:incoming>F102</bpmn:incoming>
        <bpmn:outgoing>F103</bpmn:outgoing>
        <bpmn:outgoing>F104</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R1" name="Cập nhật hồ sơ: từ chối bố trí">
        <bpmn:documentation>Hệ thống cập nhật trạng thái hồ sơ REJECTED (hộ khẩu Đà Nẵng) và lưu lý do từ chối.</bpmn:documentation>
        <bpmn:incoming>F103</bpmn:incoming>
        <bpmn:outgoing>F105</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="A104">
          <bpmn:targetRef>D1_rej</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:performer id="pf_R1" name="Chịu trách nhiệm: Bộ phận hành chính">
          <bpmn:resourceRef>Res_HC</bpmn:resourceRef>
        </bpmn:performer>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E1X" name="Từ chối bố trí ở KTX">
        <bpmn:incoming>F105</bpmn:incoming>
        <bpmn:errorEventDefinition id="E1X_def" errorRef="Err_HoKhau" />
      </bpmn:endEvent>
      <bpmn:endEvent id="E1" name="Hồ sơ hợp lệ, chuyển thẩm định">
        <bpmn:incoming>F104</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataObjectReference id="D1_in" name="Hồ sơ đăng ký&#10;[Đã nộp]" dataObjectRef="DOB_HS">
        <bpmn:dataState id="D1_in_st" name="Đã nộp" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D1_ok" name="Hồ sơ đăng ký&#10;[Đã tiếp nhận]" dataObjectRef="DOB_HS">
        <bpmn:dataState id="D1_ok_st" name="Đã tiếp nhận" />
      </bpmn:dataObjectReference>
      <bpmn:dataStoreReference id="D1_db" name="CSDL hồ sơ đăng ký" dataStoreRef="DataStore_HS" />
      <bpmn:dataObjectReference id="D1_rej" name="Hồ sơ đăng ký&#10;[Bị từ chối bố trí]" dataObjectRef="DOB_HS">
        <bpmn:dataState id="D1_rej_st" name="Bị từ chối bố trí" />
      </bpmn:dataObjectReference>
      <bpmn:sequenceFlow id="F101" sourceRef="S1" targetRef="A2" />
      <bpmn:sequenceFlow id="F102" sourceRef="A2" targetRef="A4" />
      <bpmn:sequenceFlow id="F103" name="Có (15%)" sourceRef="A4" targetRef="R1" />
      <bpmn:sequenceFlow id="F104" name="Không (85%)" sourceRef="A4" targetRef="E1" />
      <bpmn:sequenceFlow id="F105" sourceRef="R1" targetRef="E1X" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP2" name="2. Thẩm định minh chứng &#38; xử lý bổ sung">
      <bpmn:documentation>Giai đoạn 2 - Thẩm định minh chứng. AI đọc và chấm điểm tin cậy; &lt; 0,95 hoặc lỗi API chuyển cán bộ QLSV kiểm tra thủ công; không đạt thì gửi yêu cầu bổ sung và chờ sinh viên tải lại (vòng lặp) hoặc hết hạn đăng ký. Kết thúc bình thường: minh chứng đạt. Kết thúc lỗi ERR_KHONG_BO_SUNG_KIP: hồ sơ không được xét.</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:dataInputAssociation id="MA04">
        <bpmn:sourceRef>MD_HS1</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="MA05">
        <bpmn:targetRef>MD_HS2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="S2" name="Hồ sơ chờ thẩm định">
        <bpmn:outgoing>F201</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="A6" name="[AI] Kiểm tra chất lượng và tính hợp lệ minh chứng">
        <bpmn:documentation>Hệ thống tự động (AI Vision/OCR/IDP). Đọc con dấu, loại giấy tờ ưu tiên, trích xuất mã quyết định và trả về confidence_score. Multi-instance: mỗi hồ sơ một lượt. Lỗi API (429/500): thử lại tối đa 3 lần, vẫn lỗi thì chuyển xử lý thủ công.</bpmn:documentation>
        <bpmn:incoming>F201</bpmn:incoming>
        <bpmn:incoming>F214</bpmn:incoming>
        <bpmn:outgoing>F202</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A201">
          <bpmn:sourceRef>D2_mc</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A202">
          <bpmn:targetRef>D2_kq</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:performer id="pf_A6" name="Chịu trách nhiệm: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:performer>
        <bpmn:multiInstanceLoopCharacteristics id="MI_A6" />
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="EAI" name="Lỗi kết nối / quá tải API" attachedToRef="A6">
        <bpmn:documentation>Error Boundary Event: API AI sập hoặc quá hạn ngạch (429/500) sau 3 lần thử lại.</bpmn:documentation>
        <bpmn:outgoing>F203</bpmn:outgoing>
        <bpmn:errorEventDefinition id="EAI_def" errorRef="Err_AI" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="MAN" name="Chuyển xử lý thủ công">
        <bpmn:documentation>Hồ sơ lỗi AI được đẩy vào hàng đợi cho cán bộ QLSV.</bpmn:documentation>
        <bpmn:incoming>F203</bpmn:incoming>
        <bpmn:outgoing>F206</bpmn:outgoing>
        <bpmn:humanPerformer id="hp_MAN" name="Thực hiện: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A7" name="Độ tin cậy ≥ 0,95?">
        <bpmn:documentation>≥ 0,95: tự động duyệt (straight-through). &lt; 0,95: chuyển cán bộ QLSV.</bpmn:documentation>
        <bpmn:incoming>F202</bpmn:incoming>
        <bpmn:outgoing>F204</bpmn:outgoing>
        <bpmn:outgoing>F205</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A9" name="Cán bộ kiểm tra minh chứng thủ công">
        <bpmn:documentation>Cán bộ mở Dashboard, đối chiếu ảnh gốc với phần AI nghi vấn, kết luận Đạt hoặc Yêu cầu bổ sung.</bpmn:documentation>
        <bpmn:incoming>F205</bpmn:incoming>
        <bpmn:incoming>F206</bpmn:incoming>
        <bpmn:outgoing>F207</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A203">
          <bpmn:sourceRef>D2_kq2</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A204">
          <bpmn:targetRef>D2_mc2</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:humanPerformer id="hp_A9" name="Thực hiện: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="MG">
        <bpmn:incoming>F204</bpmn:incoming>
        <bpmn:incoming>F207</bpmn:incoming>
        <bpmn:outgoing>F208</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="GK" name="Minh chứng đạt?">
        <bpmn:incoming>F208</bpmn:incoming>
        <bpmn:outgoing>F209</bpmn:outgoing>
        <bpmn:outgoing>F210</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E2OK" name="Thẩm định đạt">
        <bpmn:incoming>F209</bpmn:incoming>
        <bpmn:dataInputAssociation id="A205">
          <bpmn:sourceRef>D2_mcok</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
      </bpmn:endEvent>
      <bpmn:intermediateThrowEvent id="TR" name="Gửi email yêu cầu SV bổ sung minh chứng">
        <bpmn:documentation>Gửi email/thông báo đẩy nêu rõ lý do cần chụp lại (ảnh mờ, mất góc, thiếu mộc đỏ) kèm link tải lại.</bpmn:documentation>
        <bpmn:incoming>F210</bpmn:incoming>
        <bpmn:outgoing>F211</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A206">
          <bpmn:sourceRef>D2_mcbs</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:messageEventDefinition id="TR_def" messageRef="Msg_YCBS" />
      </bpmn:intermediateThrowEvent>
      <bpmn:eventBasedGateway id="EB1">
        <bpmn:incoming>F211</bpmn:incoming>
        <bpmn:outgoing>F212</bpmn:outgoing>
        <bpmn:outgoing>F213</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="CO" name="Nhận minh chứng bổ sung từ SV">
        <bpmn:incoming>F212</bpmn:incoming>
        <bpmn:outgoing>F214</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="A207">
          <bpmn:targetRef>D2_mcbs2</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:messageEventDefinition id="CO_def" messageRef="Msg_BS" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="TO" name="Hết hạn đăng ký online">
        <bpmn:documentation>Timer: mốc hết hạn đăng ký online.</bpmn:documentation>
        <bpmn:incoming>F213</bpmn:incoming>
        <bpmn:outgoing>F215</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TO_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="R2" name="Cập nhật hồ sơ: không được xét">
        <bpmn:documentation>Hệ thống cập nhật trạng thái hồ sơ REJECTED (không bổ sung kịp).</bpmn:documentation>
        <bpmn:incoming>F215</bpmn:incoming>
        <bpmn:outgoing>F216</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="A208">
          <bpmn:targetRef>D2_hs</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:performer id="pf_R2" name="Chịu trách nhiệm: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:performer>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E2X" name="Hồ sơ không được xét">
        <bpmn:incoming>F216</bpmn:incoming>
        <bpmn:errorEventDefinition id="E2X_def" errorRef="Err_KhongXet" />
      </bpmn:endEvent>
      <bpmn:dataObjectReference id="D2_mc" name="Minh chứng ưu tiên&#10;[Đã tải lên]" dataObjectRef="DOB_MC">
        <bpmn:dataState id="D2_mc_st" name="Đã tải lên" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D2_kq" name="Kết quả thẩm định AI&#10;[Đã chấm điểm tin cậy]" dataObjectRef="DOB_KQ">
        <bpmn:dataState id="D2_kq_st" name="Đã chấm điểm tin cậy" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D2_kq2" name="Kết quả thẩm định AI&#10;[Đã chấm điểm tin cậy]" dataObjectRef="DOB_KQ">
        <bpmn:dataState id="D2_kq2_st" name="Đã chấm điểm tin cậy" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D2_mc2" name="Minh chứng ưu tiên&#10;[Đã rà soát]" dataObjectRef="DOB_MC">
        <bpmn:dataState id="D2_mc2_st" name="Đã rà soát" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D2_mcok" name="Minh chứng ưu tiên&#10;[Đạt]" dataObjectRef="DOB_MC">
        <bpmn:dataState id="D2_mcok_st" name="Đạt" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D2_mcbs" name="Minh chứng ưu tiên&#10;[Cần bổ sung]" dataObjectRef="DOB_MC">
        <bpmn:dataState id="D2_mcbs_st" name="Cần bổ sung" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D2_mcbs2" name="Minh chứng ưu tiên&#10;[Đã bổ sung]" dataObjectRef="DOB_MC">
        <bpmn:dataState id="D2_mcbs2_st" name="Đã bổ sung" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D2_hs" name="Hồ sơ đăng ký&#10;[Không được xét]" dataObjectRef="DOB_HS">
        <bpmn:dataState id="D2_hs_st" name="Không được xét" />
      </bpmn:dataObjectReference>
      <bpmn:sequenceFlow id="F201" sourceRef="S2" targetRef="A6" />
      <bpmn:sequenceFlow id="F202" sourceRef="A6" targetRef="A7" />
      <bpmn:sequenceFlow id="F203" sourceRef="EAI" targetRef="MAN" />
      <bpmn:sequenceFlow id="F204" name="Có (≥ 0,95)" sourceRef="A7" targetRef="MG" />
      <bpmn:sequenceFlow id="F205" name="Không (&#60; 0,95)" sourceRef="A7" targetRef="A9" />
      <bpmn:sequenceFlow id="F206" sourceRef="MAN" targetRef="A9" />
      <bpmn:sequenceFlow id="F207" sourceRef="A9" targetRef="MG" />
      <bpmn:sequenceFlow id="F208" sourceRef="MG" targetRef="GK" />
      <bpmn:sequenceFlow id="F209" name="Đạt" sourceRef="GK" targetRef="E2OK" />
      <bpmn:sequenceFlow id="F210" name="Không đạt" sourceRef="GK" targetRef="TR" />
      <bpmn:sequenceFlow id="F211" sourceRef="TR" targetRef="EB1" />
      <bpmn:sequenceFlow id="F212" sourceRef="EB1" targetRef="CO" />
      <bpmn:sequenceFlow id="F213" sourceRef="EB1" targetRef="TO" />
      <bpmn:sequenceFlow id="F214" sourceRef="CO" targetRef="A6" />
      <bpmn:sequenceFlow id="F215" sourceRef="TO" targetRef="R2" />
      <bpmn:sequenceFlow id="F216" sourceRef="R2" targetRef="E2X" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP3" name="3. Xếp hạng ưu tiên">
      <bpmn:documentation>Giai đoạn 3 - Xếp hạng. Business Rules Engine xếp hạng ưu tiên theo thời gian thực (dự kiến, chưa công bố) và chờ mốc hết hạn đăng ký online để sinh bảng xếp hạng cuối.</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:dataInputAssociation id="MA06">
        <bpmn:sourceRef>MD_HS2</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="MA07">
        <bpmn:targetRef>MD_XH</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="S3" name="Hồ sơ đã thẩm định đạt">
        <bpmn:outgoing>F301</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="BRE" name="Business Rules Engine xếp hạng ưu tiên thời gian thực (dự kiến, chưa công bố)">
        <bpmn:documentation>Hệ thống tự động (Business Rules Engine). Xếp hạng theo đối tượng ưu tiên, điểm và gắn phòng dự kiến; kết quả chỉ là dự kiến, chưa công bố.</bpmn:documentation>
        <bpmn:incoming>F301</bpmn:incoming>
        <bpmn:outgoing>F302</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A301">
          <bpmn:sourceRef>D3_in</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A302">
          <bpmn:targetRef>D3_out</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:performer id="pf_BRE" name="Chịu trách nhiệm: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:performer>
      </bpmn:businessRuleTask>
      <bpmn:intermediateCatchEvent id="TA" name="Hết hạn đăng ký online">
        <bpmn:documentation>Timer: mốc hết hạn đăng ký online - mở đợt chốt danh sách.</bpmn:documentation>
        <bpmn:incoming>F302</bpmn:incoming>
        <bpmn:outgoing>F303</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TA_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="E3" name="Bảng xếp hạng sẵn sàng chốt">
        <bpmn:incoming>F303</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataObjectReference id="D3_in" name="Hồ sơ đăng ký&#10;[Thẩm định đạt]" dataObjectRef="DOB_HS">
        <bpmn:dataState id="D3_in_st" name="Thẩm định đạt" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D3_out" name="Bảng xếp hạng&#10;[Dự kiến, chưa công bố]" dataObjectRef="DOB_XH">
        <bpmn:dataState id="D3_out_st" name="Dự kiến, chưa công bố" />
      </bpmn:dataObjectReference>
      <bpmn:sequenceFlow id="F301" sourceRef="S3" targetRef="BRE" />
      <bpmn:sequenceFlow id="F302" sourceRef="BRE" targetRef="TA" />
      <bpmn:sequenceFlow id="F303" sourceRef="TA" targetRef="E3" />
      <bpmn:textAnnotation id="N3">
        <bpmn:text>Vai trò chịu trách nhiệm: Bộ phận quản lý sinh viên (Business Rules Engine thực hiện tự động).</bpmn:text>
      </bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP4" name="4. Chốt &#38; phê duyệt danh sách">
      <bpmn:documentation>Giai đoạn 4 - Chốt &amp; phê duyệt. Bộ phận QLSV chốt danh sách và kiểm tra ràng buộc; Trưởng ban duyệt 1-click trên Dashboard. Nếu không thông qua (20%) thì QLSV chỉnh sửa rồi chốt lại - vòng lặp được đóng gói hoàn toàn trong sub-process. Kết thúc: danh sách được duyệt.</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:dataInputAssociation id="MA08">
        <bpmn:sourceRef>MD_XH</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="MA09">
        <bpmn:targetRef>MD_DS</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="S4" name="Bảng xếp hạng sẵn sàng chốt">
        <bpmn:outgoing>F401</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="CHOT" name="Chốt danh sách xét và kiểm tra ràng buộc (chỉ tiêu, trùng lặp, điều kiện)">
        <bpmn:documentation>Cán bộ QLSV chốt danh sách theo chỉ tiêu, kiểm tra trùng lặp và điều kiện xét.</bpmn:documentation>
        <bpmn:incoming>F401</bpmn:incoming>
        <bpmn:incoming>F406</bpmn:incoming>
        <bpmn:outgoing>F402</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A401">
          <bpmn:sourceRef>D4_xh</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A402">
          <bpmn:targetRef>D4_ds</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:humanPerformer id="hp_CHOT" name="Thực hiện: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:userTask id="B2" name="Trưởng ban duyệt danh sách (Dashboard, 1-click)">
        <bpmn:documentation>Trưởng ban xem Analytics Dashboard (tỷ lệ lấp đầy, đối tượng chính sách) và bấm Duyệt đợt (1-click).</bpmn:documentation>
        <bpmn:incoming>F402</bpmn:incoming>
        <bpmn:outgoing>F403</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A403">
          <bpmn:sourceRef>D4_ds</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:humanPerformer id="hp_B2" name="Thực hiện: Trưởng ban quản lý KTX">
          <bpmn:resourceRef>Res_TB</bpmn:resourceRef>
        </bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="B3" name="Thông qua?">
        <bpmn:documentation>Có (80%): duyệt. Không (20%): trả về chỉnh sửa.</bpmn:documentation>
        <bpmn:incoming>F403</bpmn:incoming>
        <bpmn:outgoing>F404</bpmn:outgoing>
        <bpmn:outgoing>F405</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E4" name="Danh sách được duyệt">
        <bpmn:incoming>F404</bpmn:incoming>
        <bpmn:dataInputAssociation id="A405">
          <bpmn:sourceRef>D4_ok</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
      </bpmn:endEvent>
      <bpmn:userTask id="CS" name="Chỉnh sửa danh sách hồ sơ">
        <bpmn:documentation>Cán bộ QLSV điều chỉnh danh sách theo yêu cầu của Trưởng ban rồi chốt lại.</bpmn:documentation>
        <bpmn:incoming>F405</bpmn:incoming>
        <bpmn:outgoing>F406</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A404">
          <bpmn:sourceRef>D4_tl</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:humanPerformer id="hp_CS" name="Thực hiện: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:dataObjectReference id="D4_xh" name="Bảng xếp hạng&#10;[Dự kiến, chưa công bố]" dataObjectRef="DOB_XH">
        <bpmn:dataState id="D4_xh_st" name="Dự kiến, chưa công bố" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D4_ds" name="Danh sách xét duyệt&#10;[Đã chốt]" dataObjectRef="DOB_DS">
        <bpmn:dataState id="D4_ds_st" name="Đã chốt" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D4_tl" name="Danh sách xét duyệt&#10;[Bị trả về]" dataObjectRef="DOB_DS">
        <bpmn:dataState id="D4_tl_st" name="Bị trả về" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D4_ok" name="Danh sách xét duyệt&#10;[Đã duyệt]" dataObjectRef="DOB_DS">
        <bpmn:dataState id="D4_ok_st" name="Đã duyệt" />
      </bpmn:dataObjectReference>
      <bpmn:sequenceFlow id="F401" sourceRef="S4" targetRef="CHOT" />
      <bpmn:sequenceFlow id="F402" sourceRef="CHOT" targetRef="B2" />
      <bpmn:sequenceFlow id="F403" sourceRef="B2" targetRef="B3" />
      <bpmn:sequenceFlow id="F404" name="Có (80%)" sourceRef="B3" targetRef="E4" />
      <bpmn:sequenceFlow id="F405" name="Không (20%)" sourceRef="B3" targetRef="CS" />
      <bpmn:sequenceFlow id="F406" sourceRef="CS" targetRef="CHOT" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP5" name="5. Phát hành &#38; ký hợp đồng">
      <bpmn:documentation>Giai đoạn 5 - Phát hành &amp; ký hợp đồng. Hành chính khóa danh sách và đối soát; hệ thống gửi kết quả kèm hợp đồng điện tử cho từng sinh viên; chờ phản hồi hoặc quá hạn 72 giờ. Ký: giữ phòng. Từ chối/quá hạn: hủy suất, thu hồi phòng (kết thúc lỗi ERR_HUY_SUAT).</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:dataInputAssociation id="MA10">
        <bpmn:sourceRef>MD_DS</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="MA11">
        <bpmn:targetRef>MD_HD</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="MA12">
        <bpmn:targetRef>MD_PH1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="S5" name="Danh sách đã được duyệt">
        <bpmn:outgoing>F501</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="LK" name="Khóa danh sách và đối soát trước phát hành (số lượng, mẫu thư)">
        <bpmn:documentation>Hệ thống tự động (luật/RPA). Chịu trách nhiệm: Bộ phận hành chính. Khóa danh sách, đối soát số lượng và mẫu thư trước khi phát hành.</bpmn:documentation>
        <bpmn:incoming>F501</bpmn:incoming>
        <bpmn:outgoing>F502</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A501">
          <bpmn:sourceRef>D5_ds</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A502">
          <bpmn:targetRef>D5_dk</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:performer id="pf_LK" name="Chịu trách nhiệm: Bộ phận hành chính">
          <bpmn:resourceRef>Res_HC</bpmn:resourceRef>
        </bpmn:performer>
      </bpmn:serviceTask>
      <bpmn:sendTask id="TCB" name="Công bố và gửi email kết quả (đính kèm hợp đồng điện tử)" messageRef="Msg_CongBo">
        <bpmn:documentation>Send Task (Multi-Instance song song): gửi email cá nhân hóa đến từng sinh viên trúng tuyển kèm link ký hợp đồng điện tử; hợp đồng ở trạng thái WAITING_OTP, hạn ký 72 giờ.</bpmn:documentation>
        <bpmn:incoming>F502</bpmn:incoming>
        <bpmn:outgoing>F503</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A503">
          <bpmn:sourceRef>D5_dk</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A504">
          <bpmn:targetRef>D5_hd</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:performer id="pf_TCB" name="Chịu trách nhiệm: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:performer>
        <bpmn:multiInstanceLoopCharacteristics id="MI_TCB" />
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="EB4">
        <bpmn:documentation>Chờ một trong hai sự kiện đến trước: phản hồi của sinh viên hoặc quá hạn ký.</bpmn:documentation>
        <bpmn:incoming>F503</bpmn:incoming>
        <bpmn:outgoing>F504</bpmn:outgoing>
        <bpmn:outgoing>F505</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="CK" name="SV phản hồi hợp đồng trên Web/App">
        <bpmn:documentation>Bắt sự kiện sinh viên ký (nhập đúng OTP) hoặc từ chối hợp đồng trên Web/App.</bpmn:documentation>
        <bpmn:incoming>F504</bpmn:incoming>
        <bpmn:outgoing>F506</bpmn:outgoing>
        <bpmn:messageEventDefinition id="CK_def" messageRef="Msg_PhanHoi" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="TKY" name="Quá hạn ký hợp đồng (72 giờ)">
        <bpmn:documentation>Timer duration PT72H tính từ lúc phát hành hợp đồng mà sinh viên chưa phản hồi.</bpmn:documentation>
        <bpmn:incoming>F505</bpmn:incoming>
        <bpmn:outgoing>F510</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TKY_def">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT72H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="G2" name="SV đồng ý ký?">
        <bpmn:incoming>F506</bpmn:incoming>
        <bpmn:outgoing>F507</bpmn:outgoing>
        <bpmn:outgoing>F509</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="KY" name="Ghi nhận hợp đồng đã ký và giữ phòng">
        <bpmn:documentation>Đóng dấu số vào hợp đồng PDF, cập nhật hợp đồng SIGNED, phòng chuyển trạng thái đã giữ chỗ.</bpmn:documentation>
        <bpmn:incoming>F507</bpmn:incoming>
        <bpmn:outgoing>F508</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A505">
          <bpmn:sourceRef>D5_hd2</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A506">
          <bpmn:targetRef>D5_hdk</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:dataOutputAssociation id="A507">
          <bpmn:targetRef>D5_phk</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:performer id="pf_KY" name="Chịu trách nhiệm: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:performer>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E5" name="Hợp đồng đã ký">
        <bpmn:incoming>F508</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="MG5">
        <bpmn:incoming>F509</bpmn:incoming>
        <bpmn:incoming>F510</bpmn:incoming>
        <bpmn:outgoing>F511</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="HUY" name="Hủy suất và thu hồi phòng về trạng thái trống">
        <bpmn:documentation>Đổi trạng thái hợp đồng thành CANCELED/TIMEOUT_CANCELED, hoàn trả slot phòng về AVAILABLE để xét bổ sung từ danh sách chờ.</bpmn:documentation>
        <bpmn:incoming>F511</bpmn:incoming>
        <bpmn:outgoing>F512</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A508">
          <bpmn:sourceRef>D5_hd3</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A509">
          <bpmn:targetRef>D5_hdh</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:dataOutputAssociation id="A510">
          <bpmn:targetRef>D5_pht</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:performer id="pf_HUY" name="Chịu trách nhiệm: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:performer>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E5X" name="Suất bị hủy">
        <bpmn:incoming>F512</bpmn:incoming>
        <bpmn:errorEventDefinition id="E5X_def" errorRef="Err_Huy" />
      </bpmn:endEvent>
      <bpmn:dataObjectReference id="D5_ds" name="Danh sách xét duyệt&#10;[Đã duyệt]" dataObjectRef="DOB_DS">
        <bpmn:dataState id="D5_ds_st" name="Đã duyệt" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D5_dk" name="Danh sách xét duyệt&#10;[Đã khóa]" dataObjectRef="DOB_DS">
        <bpmn:dataState id="D5_dk_st" name="Đã khóa" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D5_hd" name="Hợp đồng điện tử&#10;[Chờ ký]" dataObjectRef="DOB_HD">
        <bpmn:dataState id="D5_hd_st" name="Chờ ký" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D5_hd2" name="Hợp đồng điện tử&#10;[Chờ ký]" dataObjectRef="DOB_HD">
        <bpmn:dataState id="D5_hd2_st" name="Chờ ký" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D5_hdk" name="Hợp đồng điện tử&#10;[Đã ký]" dataObjectRef="DOB_HD">
        <bpmn:dataState id="D5_hdk_st" name="Đã ký" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D5_phk" name="Phòng KTX&#10;[Đã giữ chỗ]" dataObjectRef="DOB_PH">
        <bpmn:dataState id="D5_phk_st" name="Đã giữ chỗ" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D5_hd3" name="Hợp đồng điện tử&#10;[Chờ ký]" dataObjectRef="DOB_HD">
        <bpmn:dataState id="D5_hd3_st" name="Chờ ký" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="D5_hdh" name="Hợp đồng điện tử&#10;[Đã hủy]" dataObjectRef="DOB_HD">
