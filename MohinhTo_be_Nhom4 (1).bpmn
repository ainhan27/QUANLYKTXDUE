        </bpmn:dataOutputAssociation>
        <bpmn:dataOutputAssociation id="A606">
          <bpmn:targetRef>D6_db</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:humanPerformer id="hp_GN" name="Thực hiện: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:humanPerformer>
      </bpmn:userTask>
      <bpmn:endEvent id="E6" name="Hoàn tất bàn giao">
        <bpmn:incoming>F604</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataObjectReference id="D6_hd" name="Hợp đồng điện tử&#10;[Đã ký]" dataObjectRef="DOB_HD">
