        <bpmn:outgoing>F603</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="A603">
          <bpmn:targetRef>D6_bb</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:humanPerformer id="hp_E2" name="Thực hiện: Bộ phận quản lý sinh viên">
          <bpmn:resourceRef>Res_QLSV</bpmn:resourceRef>
        </bpmn:humanPerformer>
      </bpmn:manualTask>
      <bpmn:userTask id="GN" name="Ghi nhận số phòng vào hệ thống portal">
        <bpmn:documentation>Cán bộ cập nhật số phòng, trạng thái phòng và sinh viên vào Portal quản lý nội trú.</bpmn:documentation>
        <bpmn:incoming>F603</bpmn:incoming>
        <bpmn:outgoing>F604</bpmn:outgoing>
        <bpmn:dataInputAssociation id="A604">
          <bpmn:sourceRef>D6_bb</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A605">
