# AI Vision API (Khuyến nghị Gemini 1.5 Flash vì tốc độ cao, đa phương thức tốt & chi phí tối ưu)
GEMINI_API_KEY=AIzaSy...

# Hoặc dùng OpenAI Vision
OPENAI_API_KEY=sk-proj-...

# Cấu hình Gửi Email Tự Động (Resend API)
